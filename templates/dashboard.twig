<div class="row">
  <div class="col-md-12">
    <div class="tab-content">
      <div role="tabpanel" class="tab-pane active" id="tab-containers">

        <!-- Host System Specs Card -->
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-server me-2"></i> Server Specifications & Resources • مواصفات السيرفر والموارد</span>
            <span class="badge bg-primary" style="font-family: monospace;">148.113.251.156</span>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-sm-12 col-md-4 d-flex flex-column text-center my-auto">
                <div class="p-3">
                  <i class="bi bi-hdd-rack-fill text-primary" style="font-size: 64px;"></i>
                  <h5 class="fw-bold mt-2 mb-1">Corporate Mail Server</h5>
                  <p class="text-muted small ar-text">خادم البريد السحابي للشركات الأربع</p>
                  <div class="badge bg-success-subtle text-success p-2 w-100">
                    <i class="bi bi-shield-check me-1"></i> rDNS & DMARC Active
                  </div>
                </div>
              </div>
              <div class="col-sm-12 col-md-8">
                <div class="table-responsive">
                  <table class="table table-striped w-100 mb-0">
                    <tbody>
                      <tr>
                        <td class="fw-bold" style="width: 35%;">Hostname • اسم الخادم</td>
                        <td class="text-break"><span class="badge bg-dark fs-6">{{ hostname }}</span></td>
                      </tr>
                      <tr>
                        <td class="fw-bold">{{ lang.debug.architecture }} • المعمارية</td>
                        <td class="text-break"><span id="host_architecture">-</span></td>
                      </tr>
                      <tr>
                        <td class="fw-bold">Public IP • عنوان السيرفر</td>
                        <td class="text-break">
                          {% if ip_check == 1 %}
                            <span class="d-none badge bg-info" id="host_ipv4">-</span>
                            <span class="d-none mb-2" id="host_ipv6">-</span>
                            <button class="d-block btn btn-primary btn-sm" id="host_show_ip">
                              <span class="text">{{ lang.debug.show_ip }} • كشف العنوان</span>
                              <div class="spinner-border spinner-border-sm d-none" role="status">
                                <span class="visually-hidden">Loading...</span>
                              </div>
                            </button>
                          {% else %}
                            <span class="d-block">{{ lang.admin.ip_check_disabled|raw }}</span>
                          {% endif %}
                        </td>
                      </tr>
                      <tr>
                        <td class="fw-bold">Mailcow Version • الإصدار</td>
                        <td class="text-break">
                          <div class="fw-bolder">
                            <a href="#" id="mailcow_version">{{ mailcow_info.version_tag }}</a>
                            <span id="mailcow_update"></span>
                          </div>
                        </td>
                      </tr>
                      <tr>
                        <td class="fw-bold">{{ lang.debug.current_time }} • الوقت الحالي</td>
                        <td id="host_date" class="text-break">-</td>
                      </tr>
                      <tr>
                        <td class="fw-bold">{{ lang.debug.timezone }} • المنطقة الزمنية</td>
                        <td class="text-break"><span class="badge bg-secondary">{{ timezone }}</span></td>
                      </tr>
                      <tr>
                        <td class="fw-bold">{{ lang.debug.uptime }} • مدة التشغيل المتواصل</td>
                        <td id="host_uptime" class="text-break fw-bold text-success">-</td>
                      </tr>
                      <tr>
                        <td class="fw-bold">{{ lang.debug.disk_usage }} • مساحة البريد التخزينية</td>
                        <td class="text-break">
                          <div>
                            <span class="d-block"><i class="bi bi-hdd-fill text-primary"></i> <b>{{ vmail_df[0] }}</b></span>
                            <span class="d-block">{{ vmail_df[2] }} used / {{ vmail_df[1] }} total ({{ vmail_df[4] }})</span>
                          </div>
                          <div class="mt-2 mb-2">
                            <div class="progress" style="height: 10px; border-radius: 6px;">
                              <div class="progress-bar bg-primary" role="progressbar" style="width:{{ vmail_df[4] }}"></div>
                            </div>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- CPU & Memory Charts -->
              <div class="col-sm-6 mt-4">
                <div class="p-3 border rounded-3 bg-light">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0"><i class="bi bi-cpu text-primary me-1"></i> CPU Usage • استهلاك المعالج</h5>
                    <span class="badge bg-dark"><span id="host_cpu_cores">-</span> {{ lang.debug.cores }} @ <span id="host_cpu_usage"></span></span>
                  </div>
                  <canvas id="host_cpu_chart" width="400" height="180"></canvas>
                </div>
              </div>
