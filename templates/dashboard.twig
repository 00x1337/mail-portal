                        </button>
                        <a href="#" data-bs-toggle="modal"
                          data-container="{{ container }}"
                          data-bs-target="#RestartContainer"
                          class="btn btn-sm btn-outline-primary"
                          title="Restart this service">
                          <i class="bi bi-arrow-clockwise me-1"></i> Restart
                        </a>
                      </div>

                      <div class="collapse p-0 list-group-details container-details-collapse mt-2" id="{{ container }}Collapse" data-id="{{ container_info.Id }}">
