                  <small class="text-muted ar-text">الخادم مهيأ ومحمي بالكامل لجميع النطاقات الأربع</small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- System Containers Cards Grid -->
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-boxes me-2"></i> System Containers • حاويات وخدمات النظام المستقلة</span>
            <span class="badge bg-success">{{ containers|length }} Containers Active</span>
          </div>
          <div class="card-body p-3">
            <div class="row g-3">
              {% for container, container_info in containers %}
                  <div class="col-md-6 col-lg-4">
                    <div class="list-group-item p-3 h-100 d-flex flex-column justify-content-between">
                      <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                          <span class="fw-bold text-dark fs-6">{{ container }}</span>
                          {% if container_info.State.Running == 1 %}
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                              <i class="bi bi-check-circle-fill me-1"></i> Running • يعمل
                            </span>
                          {% elseif container_info.State %}
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                              <i class="bi bi-x-circle-fill me-1"></i> Stopped • متوقف
                            </span>
                          {% endif %}
                        </div>
                        <div class="text-muted small text-break mb-1" style="font-size: 0.76rem;">
                          <code>{{ container_info.Config.Image }}</code>
                        </div>
                        <div class="text-muted small" style="font-size: 0.74rem;">
                          Started: <span class="parse_date">{{ container_info.State.StartedAtHR }}</span>
                        </div>
                      </div>

