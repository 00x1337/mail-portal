{% extends 'base.twig' %}

{% block navbar %}{% endblock %}

{% block content %}
<div class="row mb-4" style="margin-top: 60px">
  <div class="col-12 col-md-7 col-lg-6 col-xl-5 ms-auto me-auto">

    <div class="card">
      <div class="card-header d-flex align-items-center text-break">
        <i class="bi bi-person-fill me-2"></i> {{ lang.login.login_user }}
        <div class="ms-auto form-check form-switch my-auto d-flex align-items-center">
          <label class="form-check-label"><i class="bi bi-moon-fill"></i></label>
          <input class="form-check-input ms-2" type="checkbox" id="dark-mode-toggle">
        </div>
        {% if not oauth2_request %}
        <div class="ms-4 d-grid d-sm-block">
          <button type="button" {% if available_languages|length == 1 %}disabled="true"{% endif %} class="text-secondary btn p-0 border-0 bg-transparent ms-auto dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <span class="flag-icon flag-icon-{{ mailcow_locale[-2:] }}"></span>
          </button>
          <ul class="dropdown-menu ms-auto login">
            {% for key, val in available_languages %}
              <li>
                <a class="dropdown-item {% if mailcow_locale == key %}active{% endif %}" href="?{{ query_string({'lang': key}) }}">
                  <span class="flag-icon flag-icon-{{ key[-2:] }}"></span>{{ val }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
      <div class="card-body">
        <div class="text-center mailcow-logo mb-4">
          <img class="main-logo" src="{{ logo|default('/img/cow_mailcow.svg') }}" alt="mailcow">
          <img class="main-logo-dark" src="{{ logo_dark|default('/img/cow_mailcow.svg') }}" alt="mailcow-logo-dark">
        </div>
        {% if ui_texts.ui_announcement_text and ui_texts.ui_announcement_active %}
        <div class="my-4 alert alert-{{ ui_texts.ui_announcement_type }} rot-enc ui-announcement-alert">{{ ui_texts.ui_announcement_text|rot13 }}</div>
        {% endif %}
        <legend>{% if oauth2_request %}{{ lang.oauth2.authorize_app }}{% else %}{{ ui_texts.main_name|raw }}{% endif %}</legend><hr />
        {% if is_mobileconfig %}
        <div class="my-4 alert alert-info ">{{ lang.login.mobileconfig_info }}</div>
        {% endif %}
        {% if custom_login.force_sso != 1 %}
        <form method="post" autofill="off" id="company_login_form" onsubmit="return prepareLoginSubmission();">
          <input type="hidden" name="login_user" id="final_login_user">
          
          <!-- Company Selection -->
          <div class="mb-3 text-start" dir="rtl">
            <label for="company_picker" class="form-label fw-bold text-dark" style="font-size: 0.95rem;">
              <i class="bi bi-buildings-fill text-primary me-1"></i> اختر الشركة:
            </label>
            <select id="company_picker" class="form-select form-select-lg shadow-sm border-primary-subtle" style="border-radius: 10px; font-weight: 500; font-size: 0.95rem; background-color: #f8fafc;" onchange="handleCompanyChange();">
              <option value="@qafilatfood.sa" selected>شركة قافلة الغذاء لخدمات الإعاشة (@qafilatfood.sa)</option>
              <option value="@rowaddevelopment.sa">شركة رواد التعمير والتنمية (@rowaddevelopment.sa)</option>
              <option value="@diyarsupply.sa">شركة تموين الديار (@diyarsupply.sa)</option>
              <option value="@khotoutco.sa">شركة خطوط الإنشاء للمقاولات (@khotoutco.sa)</option>
              <option value="">دخول عام / مسؤول النظام (أدخل البريد كاملاً)</option>
            </select>
          </div>

          <!-- Account Input -->
          <div class="mb-3 text-start" dir="rtl">
            <label for="account_name" class="form-label fw-bold text-dark" style="font-size: 0.95rem;">
              <i class="bi bi-person-badge-fill text-primary me-1"></i> اسم الحساب / الموظف:
            </label>
            <div class="input-group input-group-lg shadow-sm" style="direction: ltr;">
              <span class="input-group-text bg-primary-subtle text-primary fw-bold" id="domain_badge" style="font-size: 0.9rem; border-top-left-radius: 10px; border-bottom-left-radius: 10px;">@qafilatfood.sa</span>
              <input type="text" id="account_name" class="form-control" placeholder="مثال: gm أو info أو hr أو finance" required autofocus style="border-top-right-radius: 10px; border-bottom-right-radius: 10px; font-size: 1rem; direction: ltr;" oninput="onAccountInput(this);">
            </div>
            <div class="form-text text-muted mt-1" style="font-size: 0.8rem; direction: rtl;">
              اكتب اسم الحساب فقط بدون الدومين (أو اختر الدخول العام لكتابة بريد كامل).
            </div>
          </div>

          <!-- Password Input -->
          <div class="mb-3 text-start" dir="rtl">
            <label for="pass_user" class="form-label fw-bold text-dark" style="font-size: 0.95rem;">
              <i class="bi bi-key-fill text-primary me-1"></i> كلمة المرور:
            </label>
            <div class="input-group input-group-lg shadow-sm" style="direction: ltr;">
              <button type="button" class="input-group-text" style="cursor:pointer; border-top-left-radius: 10px; border-bottom-left-radius: 10px; background-color: #f8fafc;" onclick="togglePasswordVisibility();" tabindex="-1" title="إظهار / إخفاء كلمة المرور">
                <i class="bi bi-eye" id="pwd_eye_icon"></i>
              </button>
              <input name="pass_user" type="password" id="pass_user" class="form-control" placeholder="••••••••••••" required autocomplete="current-password" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;">
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-3 mt-1" dir="rtl">
            <a href="/reset-password" class="text-decoration-none text-muted" style="font-size: 0.85rem;">{{ lang.login.forgot_password }}</a>
          </div>

          <button type="submit" class="btn btn-primary btn-lg w-100 shadow fw-bold py-2 mt-2" style="border-radius: 10px; font-size: 1.05rem; background: linear-gradient(135deg, #0d6efd, #0a58ca); border: none;">
            <i class="bi bi-box-arrow-in-right me-1"></i> تسجيل الدخول إلى البريد
          </button>
        </form>

        <script>
        function handleCompanyChange() {
          var sel = document.getElementById('company_picker');
          var badge = document.getElementById('domain_badge');
          var acc = document.getElementById('account_name');
          if (sel.value === '') {
            badge.style.display = 'none';
            acc.placeholder = 'admin أو user@domain.sa';
          } else {
            badge.style.display = 'inline-block';
            badge.innerText = sel.value;
            acc.placeholder = 'مثال: info أو gm أو hr أو finance';
          }
        }
        function onAccountInput(input) {
          var val = input.value.trim();
          var sel = document.getElementById('company_picker');
          var badge = document.getElementById('domain_badge');
          if (val.indexOf('@') !== -1) {
            badge.style.display = 'none';
          } else if (sel.value !== '') {
            badge.style.display = 'inline-block';
          }
        }
        function togglePasswordVisibility() {
          var pwd = document.getElementById('pass_user');
          var icon = document.getElementById('pwd_eye_icon');
          if (pwd.type === 'password') {
            pwd.type = 'text';
            icon.className = 'bi bi-eye-slash';
          } else {
            pwd.type = 'password';
            icon.className = 'bi bi-eye';
          }
        }
        function prepareLoginSubmission() {
          var acc = document.getElementById('account_name').value.trim();
          var domain = document.getElementById('company_picker').value;
          var finalUser = acc;
          if (acc.indexOf('@') === -1 && domain !== '') {
            finalUser = acc + domain;
          }
          document.getElementById('final_login_user').value = finalUser;
          return true;
        }
        </script>
        
        <div class="hr-title"><strong>{{ lang.login.other_logins }}</strong></div>
        {% endif %}
        <div class="d-flex flex-column align-items-center">
          {% if has_iam_sso %}
          <a class="btn btn-xs-lg btn-secondary w-100 mt-2" style="max-width: 400px;" href="/?iam_sso=1"><i class="bi bi-cloud-arrow-up-fill"></i> {{ lang.admin.iam_sso }}</a>
          {% endif %}
          {% if custom_login.force_sso != 1 %}
          <a class="btn btn-xs-lg btn-secondary w-100 mt-2" style="max-width: 400px;" href="#" id="fido2-login"><i class="bi bi-shield-fill-check"></i> {{ lang.login.fido2_webauthn }}</a>
          {% endif %}
        </div>
        {% if login_delay %}
        <p><div class="my-4 alert alert-info">{{ lang.login.delayed|format(login_delay) }}</b></div></p>
        {% endif %}
        <div class="my-4" id="fido2-alerts"></div>
        {% if not oauth2_request and (mailcow_apps or app_links) and not hide_mailcow_apps %}
        <legend><i class="bi bi-link-45deg"></i> {{ ui_texts.apps_name|raw }}</legend><hr />
        <div class="my-2 apps">
          {% for app in mailcow_apps %}
            {% if not app.hide %}
              {% if not skip_sogo or not is_uri('SOGo', app.link) %}
              <div class="m-2">
                <a href="{{ app.link }}" role="button" {% if app.description %}title="{{ app.description }}"{% endif %} class="btn btn-primary btn-block">{{ app.name }}</a>
              </div>
            {% endif %}
          {% endif %}
          {% endfor %}
          {% for row in app_links %}
            {% for key, val in row %}
            {% if not val.hide %}
              <div class="m-2">
                <a href="{{ val.link }}" role="button" class="btn btn-primary btn-block">{{ key }}</a>
              </div>
            {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
        <div>
        </div>
        {% endif %}
      </div>
    </div>

    {% if custom_login.hide_admin_quicklink != 1 or custom_login.hide_domainadmin_quicklink != 1 %}
    <p class="text-center mt-3 text-muted" style="font-size: 0.9rem;">
      {{ lang.login.login_linkstext }}<br>
      {% if custom_login.hide_admin_quicklink != 1 %}<a href="/admin">{{ lang.login.login_admintext }}</a>{% endif %}
      {% if custom_login.hide_admin_quicklink != 1 and custom_login.hide_domainadmin_quicklink != 1 %}|{% endif %}
      {% if custom_login.hide_domainadmin_quicklink != 1 %}<a href="/domainadmin">{{ lang.login.login_domainadmintext }}</a>{% endif %}
    </p>
    {% endif %}
  </div>
</div>
{% if not oauth2_request and ui_texts.help_text %}
<div class="row">
  <div class="col-12 col-md-7 col-lg-6 col-xl-5 ms-auto me-auto">
    <div class="card">
      <div class="card-header">
        <a class="btn btn-link" data-bs-toggle="collapse" href="#collapse1"><i class="bi bi-patch-question-fill"></i> {{ lang.start.help }}</a>
      </div>
      <div id="collapse1" class="card-collapse collapse">
        <div class="card-body">
          <p>{{ ui_texts.help_text|raw }}</p>
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}
{% endblock %}
