{% extends 'base.twig' %}

{% block navbar %}{% endblock %}

{% block content %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap');
  
  body {
    font-family: 'Tajawal', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    background-color: #f1f5f9;
  }
  
  .portal-wrapper {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 10px;
  }

  .portal-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
    width: 100%;
    max-width: 440px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .portal-header {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    color: #ffffff;
    padding: 28px 24px 24px;
    text-align: center;
  }

  .portal-icon {
    width: 52px;
    height: 52px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #38bdf8;
    margin-bottom: 12px;
  }

  .portal-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .portal-subtitle {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-top: 4px;
    margin-bottom: 0;
  }

  .portal-body {
    padding: 28px 24px;
  }

  .field-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 6px;
    text-align: right;
  }

  .portal-input, .portal-select {
    width: 100%;
    padding: 12px 14px;
    font-size: 0.95rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    background-color: #f8fafc;
    color: #0f172a;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .portal-input:focus, .portal-select:focus {
    outline: none;
    border-color: #2563eb;
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  .account-group {
    display: flex;
    direction: ltr;
    border-radius: 10px;
    overflow: hidden;
    border: 1.5px solid #cbd5e1;
    background-color: #f8fafc;
  }

  .account-group:focus-within {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    background-color: #ffffff;
  }

  .domain-suffix {
    background-color: #e2e8f0;
    color: #1e293b;
    padding: 12px 14px;
    font-weight: 600;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    border-right: 1px solid #cbd5e1;
    user-select: none;
  }

  .account-group input {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 12px 14px;
    font-size: 0.95rem;
    flex: 1;
    outline: none;
    direction: ltr;
    text-align: left;
  }

  .password-group {
    display: flex;
    direction: ltr;
    border-radius: 10px;
    overflow: hidden;
    border: 1.5px solid #cbd5e1;
    background-color: #f8fafc;
  }

  .password-group:focus-within {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    background-color: #ffffff;
  }

  .password-group input {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 12px 14px;
    font-size: 0.95rem;
    flex: 1;
    outline: none;
    direction: ltr;
  }

  .toggle-pwd-btn {
    border: none;
    background: transparent;
    color: #64748b;
    padding: 0 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .toggle-pwd-btn:hover {
    color: #0f172a;
  }

  .btn-submit {
    width: 100%;
    padding: 12px;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    background: #0284c7;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
    transition: all 0.15s ease;
    margin-top: 8px;
  }

  .btn-submit:hover {
    background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
    box-shadow: 0 6px 16px rgba(2, 132, 199, 0.35);
    transform: translateY(-1px);
  }

  .btn-submit:active {
    transform: translateY(0);
  }

  .portal-footer {
    text-align: center;
    padding: 12px 24px 20px;
    font-size: 0.8rem;
    color: #64748b;
    border-top: 1px solid #f1f5f9;
  }

  .portal-footer a {
    color: #64748b;
    text-decoration: none;
  }

  .portal-footer a:hover {
    color: #0284c7;
    text-decoration: underline;
  }

  /* Dark mode adjustments */
  [data-bs-theme="dark"] .portal-card,
  body.dark-mode .portal-card {
    background: #1e293b;
    border-color: #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  }
  [data-bs-theme="dark"] .field-label,
  body.dark-mode .field-label {
    color: #e2e8f0;
  }
  [data-bs-theme="dark"] .portal-input,
  [data-bs-theme="dark"] .portal-select,
  [data-bs-theme="dark"] .account-group,
  [data-bs-theme="dark"] .password-group,
  body.dark-mode .portal-input,
  body.dark-mode .portal-select,
  body.dark-mode .account-group,
  body.dark-mode .password-group {
    background-color: #0f172a;
    border-color: #334155;
    color: #f8fafc;
  }
  [data-bs-theme="dark"] .domain-suffix,
  body.dark-mode .domain-suffix {
    background-color: #1e293b;
    color: #94a3b8;
    border-right-color: #334155;
  }
</style>

<div class="portal-wrapper">
  <div class="portal-card">
    
    <!-- Clean Header -->
    <div class="portal-header">
      <div class="portal-icon">
        <i class="bi bi-envelope-fill"></i>
      </div>
      <h1 class="portal-title">بوابة البريد الإلكتروني</h1>
      <p class="portal-subtitle">سجّل الدخول إلى حسابك المهني</p>
    </div>

    <!-- Clean Body -->
    <div class="portal-body">
      <form method="post" autofill="off" id="simple_login_form" onsubmit="return handleFormSubmit();">
        <input type="hidden" name="login_user" id="final_login_user">

        <!-- 1. الشركة -->
        <div class="mb-3" dir="rtl">
          <label for="company_select" class="field-label">
            الشركة
          </label>
          <select id="company_select" class="portal-select" onchange="onCompanySelectChange();">
            <option value="@qafilatfood.sa" selected>قافلة الغذاء لخدمات الإعاشة</option>
            <option value="@rowaddevelopment.sa">رواد التعمير والتنمية</option>
            <option value="@diyarsupply.sa">تموين الديار</option>
            <option value="@khotoutco.sa">خطوط الإنشاء للمقاولات</option>
            <option value="">دخول بحساب مخصص / المدير العام</option>
          </select>
        </div>

        <!-- 2. اسم المستخدم -->
        <div class="mb-3" dir="rtl">
          <label for="user_box" class="field-label">
            اسم المستخدم
          </label>
          <div class="account-group" id="account_group_box">
            <span class="domain-suffix" id="domain_label">@qafilatfood.sa</span>
            <input type="text" id="user_box" placeholder="gm أو hr أو finance أو info" required autofocus oninput="onUserInput(this);">
          </div>
        </div>

        <!-- 3. كلمة المرور -->
        <div class="mb-4" dir="rtl">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="pass_user" class="field-label mb-0">كلمة المرور</label>
          </div>
          <div class="password-group">
            <input name="pass_user" type="password" id="pass_user" placeholder="••••••••••••" required autocomplete="current-password">
            <button type="button" class="toggle-pwd-btn" onclick="togglePass();" tabindex="-1" title="إظهار / إخفاء">
              <i class="bi bi-eye" id="pwd_icon"></i>
            </button>
          </div>
        </div>

        <!-- زر الدخول -->
        <button type="submit" class="btn-submit" id="submit_btn">
          <i class="bi bi-box-arrow-in-right ms-1"></i> تسجيل الدخول
        </button>
      </form>
    </div>

    <!-- Footer -->
    <div class="portal-footer" dir="rtl">
      <a href="/admin">دخول مسؤول النظام</a>
    </div>

  </div>
</div>

<script>
function onCompanySelectChange() {
  var sel = document.getElementById('company_select');
  var label = document.getElementById('domain_label');
  var userBox = document.getElementById('user_box');
  
  if (sel.value === '') {
    label.style.display = 'none';
    userBox.placeholder = 'أدخل البريد كاملاً (مثال: admin أو user@domain.sa)';
  } else {
    label.style.display = 'flex';
    label.innerText = sel.value;
    userBox.placeholder = 'gm أو hr أو finance أو info';
  }
}

function onUserInput(input) {
  var val = input.value.trim();
  var sel = document.getElementById('company_select');
  var label = document.getElementById('domain_label');
  if (val.indexOf('@') !== -1) {
    label.style.display = 'none';
  } else if (sel.value !== '') {
    label.style.display = 'flex';
  }
}

function togglePass() {
  var pwd = document.getElementById('pass_user');
  var icon = document.getElementById('pwd_icon');
  if (pwd.type === 'password') {
    pwd.type = 'text';
    icon.className = 'bi bi-eye-slash';
  } else {
    pwd.type = 'password';
    icon.className = 'bi bi-eye';
  }
}

function handleFormSubmit() {
  var user = document.getElementById('user_box').value.trim();
  var domain = document.getElementById('company_select').value;
  var finalUser = user;
  
  if (user.indexOf('@') === -1 && domain !== '') {
    finalUser = user + domain;
  }
  
  document.getElementById('final_login_user').value = finalUser;
  
  var btn = document.getElementById('submit_btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span> جارٍ الدخول...';
  
  return true;
}
</script>
{% endblock %}
