{% extends 'base.twig' %}

{% block navbar %}{% endblock %}

{% block content %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
  
  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    background-color: #f1f5f9;
    direction: ltr;
  }
  
  .portal-wrapper {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 12px;
    direction: ltr;
  }

  .portal-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.07), 0 8px 12px -6px rgba(0, 0, 0, 0.04);
    width: 100%;
    max-width: 470px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .portal-header {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    padding: 26px 24px 22px;
    text-align: center;
  }

  .portal-icon {
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: #38bdf8;
    margin-bottom: 10px;
  }

  .portal-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .portal-subtitle {
    font-size: 0.84rem;
    color: #94a3b8;
    margin-top: 4px;
    margin-bottom: 0;
  }

  .portal-body {
    padding: 24px 22px;
    text-align: left;
  }

  .field-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #334155;
    margin-bottom: 8px;
    text-align: left;
  }

  /* Interactive Company Cards */
  .company-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 10px;
  }

  .company-tile {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
    user-select: none;
    position: relative;
    text-align: left;
  }

  .company-tile:hover {
    border-color: #93c5fd;
    background: #f0f7ff;
    transform: translateY(-1px);
  }

  .company-tile.active {
    background: #eff6ff;
    border-color: #0284c7;
    box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.18);
  }

  .tile-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: #e2e8f0;
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
    transition: all 0.18s ease;
  }

  .company-tile.active .tile-icon {
    background: #0284c7;
    color: #ffffff;
  }

  .tile-info {
    flex: 1;
    min-width: 0;
  }

  .tile-name {
    font-size: 0.84rem;
    font-weight: 700;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile-domain {
    font-size: 0.72rem;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .company-tile.active .tile-name {
    color: #0369a1;
  }

  .check-icon {
    font-size: 13px;
    color: #0284c7;
    display: none;
    flex-shrink: 0;
  }

  .company-tile.active .check-icon {
    display: block;
  }

  /* Account Input */
  .account-group {
    display: flex;
    border-radius: 10px;
    overflow: hidden;
    border: 1.5px solid #cbd5e1;
    background-color: #f8fafc;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .account-group:focus-within {
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    background-color: #ffffff;
  }

  .account-group input {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 11px 14px;
    font-size: 0.95rem;
    flex: 1;
    outline: none;
    color: #0f172a;
    font-family: inherit;
  }

  .domain-suffix {
    background-color: #e2e8f0;
    color: #0f172a;
    padding: 11px 14px;
    font-weight: 700;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    border-left: 1px solid #cbd5e1;
    user-select: none;
  }

  /* Password Input */
  .password-group {
    display: flex;
    border-radius: 10px;
    overflow: hidden;
    border: 1.5px solid #cbd5e1;
    background-color: #f8fafc;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .password-group:focus-within {
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    background-color: #ffffff;
  }

  .password-group input {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 11px 14px;
    font-size: 0.95rem;
    flex: 1;
    outline: none;
    color: #0f172a;
    font-family: inherit;
  }

  .toggle-pwd-btn {
    border: none;
    background: transparent;
    color: #64748b;
    padding: 0 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .toggle-pwd-btn:hover {
    color: #0f172a;
  }

  /* Submit Button */
  .btn-submit {
    width: 100%;
    padding: 13px;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
    transition: all 0.15s ease;
    margin-top: 6px;
    font-family: inherit;
  }

  .btn-submit:hover {
    background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
    box-shadow: 0 6px 18px rgba(2, 132, 199, 0.4);
    transform: translateY(-1px);
  }

  .btn-submit:active {
    transform: translateY(0);
  }

  .portal-footer {
    text-align: center;
    padding: 14px 20px 18px;
    font-size: 0.82rem;
    color: #64748b;
    border-top: 1px solid #f1f5f9;
  }

  .portal-footer a {
    color: #64748b;
    text-decoration: none;
  }

  .portal-footer a:hover {
    color: #0284c7;
    text-decoration: underline;
  }

  /* Dark mode */
  [data-bs-theme="dark"] .portal-card,
  body.dark-mode .portal-card {
    background: #1e293b;
    border-color: #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  }
  [data-bs-theme="dark"] .field-label,
  body.dark-mode .field-label {
    color: #e2e8f0;
  }
  [data-bs-theme="dark"] .company-tile,
  body.dark-mode .company-tile {
    background: #0f172a;
    border-color: #334155;
  }
  [data-bs-theme="dark"] .company-tile.active,
  body.dark-mode .company-tile.active {
    background: rgba(2, 132, 199, 0.2);
    border-color: #38bdf8;
  }
  [data-bs-theme="dark"] .tile-name,
  body.dark-mode .tile-name {
    color: #f1f5f9;
  }
  [data-bs-theme="dark"] .tile-icon,
  body.dark-mode .tile-icon {
    background: #1e293b;
    color: #94a3b8;
  }
  [data-bs-theme="dark"] .account-group,
  [data-bs-theme="dark"] .password-group,
  body.dark-mode .account-group,
  body.dark-mode .password-group {
    background-color: #0f172a;
    border-color: #334155;
    color: #f8fafc;
  }
  [data-bs-theme="dark"] .domain-suffix,
  body.dark-mode .domain-suffix {
    background-color: #1e293b;
    color: #cbd5e1;
    border-left-color: #334155;
  }
  [data-bs-theme="dark"] .account-group input,
  [data-bs-theme="dark"] .password-group input,
  body.dark-mode .account-group input,
  body.dark-mode .password-group input {
    color: #f8fafc;
  }
</style>

<div class="portal-wrapper">
  <div class="portal-card">
    
    <!-- Header -->
    <div class="portal-header">
      <div class="portal-icon">
        <i class="bi bi-shield-lock-fill"></i>
      </div>
      <h1 class="portal-title">Corporate Webmail</h1>
      <p class="portal-subtitle">Sign in to your work email</p>
    </div>

    <!-- Form Body -->
    <div class="portal-body">
      <form method="post" autofill="off" id="simple_login_form" onsubmit="return handleFormSubmit();">
        <input type="hidden" name="login_user" id="final_login_user">
        <input type="hidden" id="selected_domain" value="@qafilatfood.sa">

        <!-- 1. Company Selection -->
        <div class="mb-3">
          <label class="field-label">
            <i class="bi bi-buildings-fill text-primary"></i> Select Company
          </label>
          
          <div class="company-grid">
            <!-- Qafilat Food -->
            <div class="company-tile active" onclick="selectCompany('@qafilatfood.sa', this);" title="Qafilat Food Catering Services">
              <div class="tile-icon"><i class="bi bi-basket2-fill"></i></div>
              <div class="tile-info">
                <div class="tile-name">Qafilat Food</div>
                <div class="tile-domain">qafilatfood.sa</div>
              </div>
              <i class="bi bi-check-circle-fill check-icon"></i>
            </div>

            <!-- Rowad Development -->
            <div class="company-tile" onclick="selectCompany('@rowaddevelopment.sa', this);" title="Rowad Development & Construction">
              <div class="tile-icon"><i class="bi bi-building"></i></div>
              <div class="tile-info">
                <div class="tile-name">Rowad Dev</div>
                <div class="tile-domain">rowaddevelopment.sa</div>
              </div>
              <i class="bi bi-check-circle-fill check-icon"></i>
            </div>

            <!-- Diyar Supply -->
            <div class="company-tile" onclick="selectCompany('@diyarsupply.sa', this);" title="Diyar Supply Co.">
              <div class="tile-icon"><i class="bi bi-boxes"></i></div>
              <div class="tile-info">
                <div class="tile-name">Diyar Supply</div>
                <div class="tile-domain">diyarsupply.sa</div>
              </div>
              <i class="bi bi-check-circle-fill check-icon"></i>
            </div>

            <!-- Khotout Co -->
            <div class="company-tile" onclick="selectCompany('@khotoutco.sa', this);" title="Khotout Construction Co.">
              <div class="tile-icon"><i class="bi bi-hammer"></i></div>
              <div class="tile-info">
                <div class="tile-name">Khotout Co.</div>
                <div class="tile-domain">khotoutco.sa</div>
              </div>
              <i class="bi bi-check-circle-fill check-icon"></i>
            </div>
          </div>
        </div>

        <!-- 2. Username -->
        <div class="mb-3">
          <label for="user_box" class="field-label">
            <i class="bi bi-person-badge-fill text-primary"></i> Username
          </label>
          <div class="account-group" id="account_group_box">
            <input type="text" id="user_box" placeholder="e.g. gm, hr, finance, or info" required autofocus oninput="onUserInput(this);">
            <span class="domain-suffix" id="domain_label">@qafilatfood.sa</span>
          </div>
        </div>

        <!-- 3. Password -->
        <div class="mb-4">
          <label for="pass_user" class="field-label">
            <i class="bi bi-key-fill text-primary"></i> Password
          </label>
          <div class="password-group">
            <input name="pass_user" type="password" id="pass_user" placeholder="••••••••••••" required autocomplete="current-password">
            <button type="button" class="toggle-pwd-btn" onclick="togglePass();" tabindex="-1" title="Show / Hide Password">
              <i class="bi bi-eye" id="pwd_icon"></i>
            </button>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-submit" id="submit_btn">
          <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </button>
      </form>
    </div>

  </div>
</div>

<script>
function selectCompany(domain, el) {
  var tiles = document.querySelectorAll('.company-tile');
  tiles.forEach(function(t) { t.classList.remove('active'); });
  el.classList.add('active');

  document.getElementById('selected_domain').value = domain;

  var label = document.getElementById('domain_label');
  var userBox = document.getElementById('user_box');
  label.style.display = 'flex';
  label.innerText = domain;
  userBox.placeholder = 'e.g. gm, hr, finance, or info';
  userBox.focus();
}

function onUserInput(input) {
  var val = input.value.trim();
  var domain = document.getElementById('selected_domain').value;
  var label = document.getElementById('domain_label');
  if (val.indexOf('@') !== -1) {
    label.style.display = 'none';
  } else if (domain !== '') {
    label.style.display = 'flex';
  }
}

function togglePass() {
  var pwd = document.getElementById('pass_user');
  var icon = document.getElementById('pwd_icon');
  if (pwd.type === 'password') {
    pwd.type = 'text';
    icon.className = 'bi bi-eye-slash';
  } else {
    pwd.type = 'password';
    icon.className = 'bi bi-eye';
  }
}

function handleFormSubmit() {
  var user = document.getElementById('user_box').value.trim();
  var domain = document.getElementById('selected_domain').value;
  var finalUser = user;

  if (user.indexOf('@') === -1 && domain !== '') {
    finalUser = user + domain;
  }

  document.getElementById('final_login_user').value = finalUser;

  var btn = document.getElementById('submit_btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Signing in...';

  return true;
}
</script>
{% endblock %}
